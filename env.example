# Only needed when running on your own PC or a server (not for GitHub).
# Copy this file to ".env" and fill in your values. Never upload .env anywhere.
TELEGRAM_BOT_TOKEN=123456789:paste-your-bot-token-here
TELEGRAM_CHAT_ID=123456789
# Optional: your Plaza login for auto-apply. Leave empty for notify-only.
PLAZA_USERNAME=
PLAZA_PASSWORD=
# Optional: seconds between checks when running continuously (default 60)
CHECK_INTERVAL=60
